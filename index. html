<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Mastermind Bot - Advanced</title>
    <link rel="stylesheet" href="style.css">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- PWA Manifest -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#10a37f">
</head>
<body>

    <div class="app-container">
        <!-- Sidebar for Chat History -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <button class="new-chat-btn" onclick="startNewChat()">
                    <i class="fa-solid fa-plus"></i> न्यू चैट शुरू करें
                </button>
            </div>
            <div class="history-list" id="historyList">
                <!-- Chat history items will load here -->
            </div>
            <div class="sidebar-footer">
                <button class="install-btn" id="installAppBtn" style="display: none;">
                    <i class="fa-solid fa-download"></i> ऐप डाउनलोड करें
                </button>
            </div>
        </aside>

        <!-- Main Chat Area -->
        <main class="chat-main">
            <header class="chat-header">
                <button class="menu-toggle" onclick="toggleSidebar()">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h2>AI Mastermind</h2>
                <div class="api-key-container">
                    <button onclick="setApiKey()" class="api-btn" title="API Key सेट करें">
                        <i class="fa-solid fa-key"></i>
                    </button>
                </div>
            </header>

            <div class="chat-messages" id="chatMessages">
                <div class="message ai-message">
                    <div class="avatar"><i class="fa-solid fa-robot"></i></div>
                    <div class="content">
                        नमस्ते! मैं आपका एडवांस AI असिस्टेंट हूँ। आप मुझसे कोडिंग, पढ़ाई, या किसी भी मसले पर मदद ले सकते हैं। बताइए, आज मैं आपकी क्या मदद करूँ?
                    </div>
                </div>
            </div>

            <div class="chat-input-area">
                <div class="input-wrapper">
                    <textarea id="userInput" placeholder="यहाँ अपना सवाल लिखें..." rows="1" onkeydown="handleKeyPress(event)"></textarea>
                    <button id="sendBtn" onclick="sendMessage()">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
                <div class="footer-note">AI गलतियाँ कर सकता है, ज़रूरी जानकारी की जाँच कर लें।</div>
            </div>
        </main>
    </div>

    <!-- Marked.js for Markdown parsing -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="script.js"></script>
</body>
</html>
