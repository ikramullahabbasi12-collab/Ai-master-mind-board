* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #131314;
    color: #e3e3e3;
    display: flex;
    height: 100vh;
    overflow: hidden;
}

/* سائیڈ بار اسٹائل */
.sidebar {
    width: 260px;
    background-color: #1e1f20;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 15px;
    border-right: 1px solid #2d2e30;
}

.new-chat-btn {
    background-color: #282a2c;
    color: #e3e3e3;
    border: none;
    padding: 12px 15px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background 0.2s;
    margin-bottom: 20px;
}

.new-chat-btn:hover {
    background-color: #383a3c;
}

.history-container {
    flex: 1;
    overflow-y: auto;
}

.history-item {
    padding: 10px 12px;
    font-size: 14px;
    color: #c4c7c5;
    cursor: pointer;
    border-radius: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 5px;
}

.history-item:hover {
    background-color: #282a2c;
}

/* مین چیট ونڈو */
.main-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100vh;
    background-color: #131314;
}

.chat-header {
    padding: 15px 25px;
    font-size: 18px;
    font-weight: 500;
    color: #c4c7c5;
    border-bottom: 1px solid #2d2e30;
}

/* چیٹ میسجز ایریا */
.chat-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
}

.message {
    display: flex;
    gap: 15px;
    line-height: 1.6;
    font-size: 15px;
}

.message.user {
    justify-content: flex-end;
}

.message-content {
    background-color: #1e1f20;
    padding: 12px 18px;
    border-radius: 12px;
    max-width: 75%;
}

.message.user .message-content {
    background-color: #2b2d30;
    color: #ffffff;
    border-top-right-radius: 2px;
}

.message.bot .message-content {
    background-color: #1e1f20;
    color: #e3e3e3;
    border-top-left-radius: 2px;
}

/* ان پٹ سیکشن */
.chat-input-area {
    padding: 20px;
    display: flex;
    justify-content: center;
    background: linear-gradient(transparent, #131314 50%);
}

.input-box {
    position: relative;
    width: 100%;
    max-width: 800px;
    background-color: #1e1f20;
    border-radius: 30px;
    display: flex;
    align-items: center;
    padding: 8px 15px;
    border: 1px solid #3c4043;
}

.input-box input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 15px;
    padding: 8px;
}

.input-box input::placeholder {
    color: #8e918f;
}

.input-box button {
    background: none;
    border: none;
    color: #8e918f;
    cursor: pointer;
    font-size: 18px;
    padding: 5px 10px;
    transition: color 0.2s;
}

.input-box button:hover {
    color: #ffffff;
}
